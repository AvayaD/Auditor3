<Window x:Class="Auditor3.jirasearchdWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="jirasearchd" SizeToContent="WidthAndHeight">
    <Grid Style="{StaticResource StandardGrid}">
        <StackPanel Style="{StaticResource StandardStackPanel}" Orientation="Vertical">
            <CheckBox Style="{StaticResource FixedCheckBox}" Content="StringSearch" Name="StringSearch" HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource FixedTextBox}" Width="400" Name="Search" />
            <StackPanel Style="{StaticResource StandardStackPanel}" HorizontalAlignment="Center">
                <Button Style="{StaticResource StandardButton}" Content="SEARCH" Click="Click_Search" />
                <Button Style="{StaticResource StandardButton}" Content="CANCEL" Click="Click_Cancel" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
