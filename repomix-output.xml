                <MenuItem Style="{StaticResource StandardMenuItem}" Header="Script Generator" Click="Click_ScriptGenerator" />
                <MenuItem Style="{StaticResource StandardMenuItem}" Header="Stage Lab" Name="StageLabButton" Click="Click_StageLab" IsEnabled="False" />
                <MenuItem Style="{StaticResource StandardMenuItem}" Header="WEBASG TEST" Click="Click_WebASGTest" />
