            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Style="{StaticResource StandardMenu}" Grid.Row="0">
            <MenuItem Style="{StaticResource TopLevelMenuItemStyle}" Header="_File">
